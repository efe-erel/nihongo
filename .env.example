# Copy this file to .env and adjust the values for your setup.
# .env is gitignored; .env.example is committed as documentation.

# Database used by the FastAPI backend.
# Relative SQLite paths are resolved against the project root, so this works
# no matter which directory you start uvicorn from.
DATABASE_URL=sqlite:///data/app.db

# Base URL the Streamlit frontend uses to reach the FastAPI backend.
API_URL=http://127.0.0.1:8001
